rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOnCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    function userIdUnchanged() {
      return !('userId' in resource.data) || resource.data.userId == request.resource.data.userId;
    }

    // ===== TOP-LEVEL COLLECTIONS =====
    match /{collection}/{docId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();

      // Only owner can create (with their own userId) or admin
      allow create: if isOwnerOnCreate() || isAdmin();

      // Only owner can update/delete or admin
      // PLUS: fallback for old documents without userId
      allow update, delete: if isAdmin()
        || isOwner(resource.data.userId)
        || !('userId' in resource.data); // Fallback for old docs
    }

    // ===== USER DOCUMENTS & SUBCOLLECTIONS =====
    match /users/{userId} {
      // User document itself
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();

      // Subcollection: users/{userId}/photos
      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin()
          || !('userId' in resource.data);
      }

      // Subcollection: users/{userId}/albums
      match /albums/{albumId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin()
          || !('userId' in resource.data);
      }

      // Subcollection: users/{userId}/vault
      match /vault/{vaultId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Any other subcollections under users
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ===== DENY EVERYTHING ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
