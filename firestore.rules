rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role == 'admin';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserTier() {
      let userData = getUserData();
      return userData.subscriptionTier != null ? userData.subscriptionTier : 'GRATIS';
    }

    // 🟡 ANBEFALING 1: Sikker getUserData med exists() sjekk
    function getUserData() {
      let snap = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return snap.exists ? snap.data : {};
    }

    function getUserTier() {
      let userData = getUserData();
      return userData.subscriptionTier != null ? userData.subscriptionTier : 'GRATIS';
    }

    function canUploadVideo() {
      let tier = getUserTier();
      return isAdmin() || tier == 'PRO';
    }

    function canUploadDocument() {
      let tier = getUserTier();
      return isAdmin() || tier == 'LITE' || tier == 'PRO';
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Validate subscriptionTier field
    function isValidTier() {
      return !('subscriptionTier' in request.resource.data) ||
             request.resource.data.subscriptionTier in ['GRATIS', 'LITE', 'PRO'];
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      allow create: if isAuthenticated() && isOwner(userId) && isValidTier();

      // 🔴 PROBLEM 1 FIX: Korrekt parenteser for operator-prioritet
      allow update: if (
        isAuthenticated()
        && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || isAdmin();

      allow delete: if isAdmin();

      // ============================================================
      // SUBCOLLECTIONS UNDER /users/{userId}
      // ============================================================

      // Vault (sikret til kun eier)
      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Collages
      match /collages/{collageId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

        allow create: if isAuthenticated() && isOwner(userId)
          // CRITICAL: Enforce tier restrictions (LITE or PRO can save)
          && (getUserTier() != 'GRATIS' || isAdmin());

        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Photos under /users/{userId}/photos
      match /photos/{photoId} {
        // PUBLIC ACCESS for photos in public albums
        allow read: if
          resource.data.albumId != null &&
          exists(/databases/$(database)/documents/albums/$(resource.data.albumId)) &&
          get(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.isPublic == true;

        // Authenticated owner/admin access
        allow read, write, update, delete: if isOwner(userId) || isAdmin();
      }

      // Default for other subcollections
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ============================================================
    // ALBUMS COLLECTION (top-level)
    // ============================================================

    match /albums/{albumId} {
      // 🔴 PROBLEM 2 FIX: Slå sammen doble allow read regler
      allow read: if
        (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()))
        || resource.data.isPublic == true;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // CRITICAL: Enforce 5-album limit for GRATIS tier
        && (getUserTier() != 'GRATIS'
            || getUserData().currentAlbumCount < 5
            || isAdmin());

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ============================================================
    // PHOTOS COLLECTION (top-level)
    // ============================================================

    match /photos/{photoId} {
      // 🔴 PROBLEM 2 FIX: Slå sammen doble allow read regler
      allow read: if
        (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()))
        || (
          resource.data.albumId != null &&
          exists(/databases/$(database)/documents/albums/$(resource.data.albumId)) &&
          get(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.isPublic == true
        );

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isEmailVerified()
        && (
          // CRITICAL FIX: Check mimeType OR type field
          // Use mimeType if available (more reliable), fallback to type
          let mimeType = 'mimeType' in request.resource.data
            ? request.resource.data.mimeType
            : request.resource.data.type;

          // Detect videos by MIME type
          let isVideo = mimeType != null && (
            mimeType.matches('video/.*')
          );

          // Detect documents by MIME type
          let isDocument = mimeType != null && (
            mimeType.matches('application/pdf.*') ||
            mimeType.matches('application/vnd\\.openxmlformats-officedocument.*') ||
            mimeType.matches('application/msword.*') ||
            mimeType.matches('application/vnd\\.ms-.*') ||
            mimeType == 'text/plain'
          );

          // Enforce tier restrictions
          // Videos: PRO only
          (!isVideo || canUploadVideo())
          &&
          // Documents: LITE or PRO
          (!isDocument || canUploadDocument())
        );

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin())
        // CRITICAL: Email verification required for delete
        && isEmailVerified();
    }

    // ============================================================
    // GENERELL FALLBACK-REGEL
    // ============================================================

    match /{collection}/{docId} {
      allow read: if isAuthenticated();

      allow create: if isOwnerOnCreate() || isAdmin();

      // 🟡 ANBEFALING 2: Strammere fallback-regel
      // Fjernet: || !('userId' in resource.data)
      // Dette forhindrer at documents uten userId kan endres av hvem som helst
      allow update, delete: if isAdmin()
        || (resource.data.userId != null && isOwner(resource.data.userId));
    }

    // ============================================================
    // DEFAULT DENY (viktig!)
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
