rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS (NO `let`)
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isAuthenticated() && exists(userDocPath());
    }

    function isAdmin() {
      return userDocExists() && get(userDocPath()).data.role == 'admin';
    }

    function getUserTier() {
      return (userDocExists() && get(userDocPath()).data.subscriptionTier != null)
        ? get(userDocPath()).data.subscriptionTier
        : 'GRATIS';
    }

    function canUploadVideo() {
      return isAdmin() || getUserTier() == 'PRO';
    }

    function canUploadDocument() {
      return isAdmin() || getUserTier() == 'LITE' || getUserTier() == 'PRO';
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Validate subscriptionTier field on user create
    function isValidTierOnCreate() {
      return !('subscriptionTier' in request.resource.data)
        || request.resource.data.subscriptionTier in ['GRATIS', 'LITE', 'PRO'];
    }

    function isOwnerOnCreate() {
      return isAuthenticated()
        && ('userId' in request.resource.data)
        && request.resource.data.userId == request.auth.uid;
    }

    // Helpers for content type detection
    function getMimeOrType() {
      return ('mimeType' in request.resource.data) ? request.resource.data.mimeType : request.resource.data.type;
    }

    function isVideoUpload() {
      return getMimeOrType() != null && getMimeOrType().matches('video/.*');
    }

    function isDocumentUpload() {
      return getMimeOrType() != null && (
        getMimeOrType().matches('application/pdf.*') ||
        getMimeOrType().matches('application/vnd\\.openxmlformats-officedocument.*') ||
        getMimeOrType().matches('application/msword.*') ||
        getMimeOrType().matches('application/vnd\\.ms-.*') ||
        getMimeOrType() == 'text/plain'
      );
    }

    function albumExistsAndIsPublic(albumId) {
      return albumId != null
        && exists(/databases/$(database)/documents/albums/$(albumId))
        && get(/databases/$(database)/documents/albums/$(albumId)).data.isPublic == true;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      allow create: if isAuthenticated() && isOwner(userId) && isValidTierOnCreate();

      // Prevent privilege escalation on role
      allow update: if (
        isAuthenticated()
        && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || isAdmin();

      allow delete: if isAdmin();

      // ----------------------------
      // SUBCOLLECTIONS
      // ----------------------------

      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /collages/{collageId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

        // LITE/PRO only (admin override)
        allow create: if isAuthenticated() && isOwner(userId)
          && (getUserTier() != 'GRATIS' || isAdmin());

        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // If you really have /users/{uid}/photos docs, keep this.
      // NOTE: This does NOT enforce tier/email; your app should write photos to top-level /photos for enforcement.
      match /photos/{photoId} {
        // Public access for photos in public albums
        allow read: if albumExistsAndIsPublic(resource.data.albumId);

        allow read, write, update, delete: if isOwner(userId) || isAdmin();
      }

      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ============================================================
    // SYSTEM CONFIG (Admin kill-switches)
    // ============================================================

    match /systemConfig/{configId} {
      // Anyone can read (to check if uploads/signups are disabled)
      allow read: if true;

      // Only admins can modify
      allow write: if isAdmin();
    }

    // ============================================================
    // ALBUMS COLLECTION (top-level)
    // ============================================================

    match /albums/{albumId} {
      allow read: if
        (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()))
        || resource.data.isPublic == true;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // 5-album limit for GRATIS based on user's currentAlbumCount
        && (
          getUserTier() != 'GRATIS'
          || (userDocExists() && get(userDocPath()).data.currentAlbumCount < 5)
          || isAdmin()
        );

      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ============================================================
    // PHOTOS COLLECTION (top-level)
    // ============================================================

    match /photos/{photoId} {
      allow read: if
        (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()))
        || albumExistsAndIsPublic(resource.data.albumId);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isEmailVerified()
        // Tier restrictions by mime/type
        && (!isVideoUpload() || canUploadVideo())
        && (!isDocumentUpload() || canUploadDocument());

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && isEmailVerified();
    }

    // ============================================================
    // GENERELL FALLBACK-REGEL (tight)
    // ============================================================

    match /{collection}/{docId} {
      allow read: if isAuthenticated();

      allow create: if isOwnerOnCreate() || isAdmin();

      allow update, delete: if isAdmin()
        || (resource.data.userId != null && isOwner(resource.data.userId));
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
