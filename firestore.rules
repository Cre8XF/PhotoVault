rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOnCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    function userIdUnchanged() {
      return resource.data.userId == request.resource.data.userId;
    }

    // Main rule: All authenticated users can READ everything,
    // but can only CREATE/EDIT/DELETE their own data
    match /{collection}/{docId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();

      // Only owner can create (with their own userId) or admin
      allow create: if isOwnerOnCreate() || isAdmin();

      // Only owner can update/delete (userId must not change) or admin
      // PLUS: fallback for old documents without userId
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId) && userIdUnchanged())
        || !('userId' in resource.data); // Allow old docs without userId
    }

    // Explicitly deny anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
