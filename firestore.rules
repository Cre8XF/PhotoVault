rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOnCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ===== TOP-LEVEL COLLECTIONS =====
    match /{collection}/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOnCreate() || isAdmin();

      // ✅ gir slettetilgang enten via resource.data.userId (hvis finnes)
      // eller via fallback for dokumenter uten userId-felt
      allow update, delete: if isAdmin()
        || (resource.data.userId != null && isOwner(resource.data.userId))
        || !('userId' in resource.data);
    }

    // ===== USER-BASERT STRUKTUR =====
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();

      // --- Photos ---
      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin()
          || !('userId' in resource.data);
      }

      // --- Albums ---
      match /albums/{albumId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();

        // ✅ tillater sletting fra både Netlify og lokal emulator
        allow update, delete: if isOwner(userId)
          || (resource.data.userId != null && isOwner(resource.data.userId))
          || isAdmin()
          || !('userId' in resource.data);
      }

      // --- Vault ---
      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- Andre sub-samlinger ---
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ===== DEFAULT DENY =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
