rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------
    // Helper Functions
    // -----------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    // Sjekk eierskap mot eksisterende dokument (resource)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Sjekk eierskap ved opprettelse (request.resource.data)
    // Brukes når dokumentet ikke finnes ennå
    function isOwnerOnCreate(userId) {
      return isAuthenticated()
        && request.resource != null
        && request.resource.data.userId == userId;
    }

    // -----------------------------
    // USERS
    // -----------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwnerOnCreate(userId) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();

      // -----------------------------
      // ALBUMS (nested under user)
      // -----------------------------
      match /albums/{albumId} {
        allow read: if isOwner(userId) || isAdmin();
        // Ved create finnes ikke resource ennå, så vi bruker parent userId
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // -----------------------------
      // PHOTOS (nested under album)
      // -----------------------------
      match /albums/{albumId}/photos/{photoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // -----------------------------
      // UNASSIGNED (temp uploads)
      // -----------------------------
      match /unassigned/{fileId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // -----------------------------
    // VAULT (encrypted) – hvis dere lagrer i Firestore
    // -----------------------------
    match /vault/{userId}/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwnerOnCreate(userId) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // ENHANCED (AI-improved) – hvis dere lagrer i Firestore
    // -----------------------------
    match /enhanced/{userId}/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwnerOnCreate(userId) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // GLOBAL COLLECTIONS (admin only)
    // -----------------------------
    match /albums/{albumId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read, create, update, delete: if isAdmin();
    }

    // -----------------------------
    // FALLBACK (deny by default)
    // -----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
