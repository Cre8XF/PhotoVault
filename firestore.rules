rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role == 'admin';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserTier() {
      let userData = getUserData();
      return userData.subscriptionTier != null ? userData.subscriptionTier : 'GRATIS';
    }

    function canUploadVideo() {
      let tier = getUserTier();
      return isAdmin() || tier == 'PRO';
    }

    function canUploadDocument() {
      let tier = getUserTier();
      return isAdmin() || tier == 'LITE' || tier == 'PRO';
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      allow create: if isAuthenticated() && isOwner(userId);

      allow update: if isAuthenticated() && isOwner(userId)
        // Prevent privilege escalation
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin();

      allow delete: if isAdmin();

      // ============================================================
      // COLLAGES SUBCOLLECTION
      // ============================================================

      match /collages/{collageId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

        allow create: if isAuthenticated() && isOwner(userId)
          // CRITICAL: Enforce tier restrictions (LITE or PRO can save)
          && (getUserTier() != 'GRATIS' || isAdmin());

        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Vault and other subcollections
      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Default for other subcollections
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ============================================================
    // ALBUMS COLLECTION
    // ============================================================

    match /albums/{albumId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Public override
      allow read: if resource.data.isPublic == true;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // CRITICAL: Enforce 5-album limit for GRATIS tier
        && (getUserTier() != 'GRATIS'
            || getUserData().currentAlbumCount < 5
            || isAdmin());

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ============================================================
    // PHOTOS COLLECTION
    // ============================================================

    match /photos/{photoId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Public fallback: Allow reading photos in public albums
      allow read: if
        resource.data.albumId != null &&
        exists(/databases/$(database)/documents/albums/$(resource.data.albumId)) &&
        get(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.isPublic == true;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // CRITICAL: Enforce tier restrictions
        && (
          // Videos: PRO only
          (request.resource.data.type != 'video' || canUploadVideo())
          &&
          // Documents: LITE or PRO
          (request.resource.data.type != 'document' || canUploadDocument())
        )
        // CRITICAL: Email verification required
        && isEmailVerified();

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin())
        // CRITICAL: Email verification required for delete
        && isEmailVerified();
    }

    // ============================================================
    // GENERELL TILGANG (FALLBACK)
    // ============================================================

    match /{collection}/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin()
        || (resource.data.userId != null && isOwner(resource.data.userId))
        || !('userId' in resource.data);
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
