rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOnCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ===== ALBUMS (før generelle regler) =====
    match /albums/{albumId} {
      // Alle kan lese hvis albumet er offentlig
      allow read: if resource.data.isPublic == true;

      // Eier eller admin kan lese/skrive alt
      allow read, write, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ===== TOP-LEVEL COLLECTIONS =====
    match /{collection}/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOnCreate() || isAdmin();
      allow update, delete: if isAdmin()
        || (resource.data.userId != null && isOwner(resource.data.userId))
        || !('userId' in resource.data);
    }

    // ===== USER-BASERT STRUKTUR =====
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();

      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin()
          || !('userId' in resource.data);
      }

      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ===== DEFAULT DENY =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
