# ============================================================================
# PhotoVault Environment Configuration Template
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual API keys and configuration values
# 3. Never commit the .env file to version control
#
# ============================================================================

# ============================================================================
# FIREBASE CONFIGURATION (Required)
# ============================================================================
# Get these values from your Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
#
# NOTE: This project uses Vite, so all environment variables MUST be prefixed
# with VITE_ to be accessible in the application.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================================
# AI SERVICE API KEYS (Optional - for AI features)
# ============================================================================

# Google Cloud Vision API
# Get your key from: https://console.cloud.google.com/apis/credentials
# Free tier: 1000 requests/month
VITE_GOOGLE_VISION_KEY=your_google_vision_api_key_here

# Picsart API
# Get your key from: https://picsart.io/
# Used for image enhancement and background removal
VITE_PICSART_KEY=your_picsart_api_key_here

# OpenAI API (for GPT-based smart sorting)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_KEY=your_openai_api_key_here

# ============================================================================
# CLOUDFLARE R2 STORAGE (Production Storage Backend)
# ============================================================================

# Enable R2 storage (set to 'true' to use R2 instead of Firebase Storage)
VITE_R2_ENABLED=true

# R2 upload endpoint (your Cloudflare Worker that handles file uploads)
# This is the upload worker deployed to Cloudflare
# Deploy: cd cloudflare/upload-worker && wrangler deploy --env production
VITE_R2_UPLOAD_ENDPOINT=https://upload.pixtr.cloud

# R2 public URL base (for accessing uploaded files via custom domain)
# This should match your R2 bucket's custom domain configuration
VITE_R2_PUBLIC_URL=https://photos.pixtr.cloud

# ============================================================================
# CLOUDFLARE METADATA ENGINE (Pixtr Storage Auto-Repair)
# ============================================================================

# URL to your deployed Cloudflare metadata worker
VITE_METADATA_API_URL=https://metadata-worker.your-domain.workers.dev

# Admin token for repair-all endpoint (must match worker's ADMIN_TOKEN)
VITE_ADMIN_TOKEN=your-secure-admin-token-here

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug logging (true/false)
VITE_DEBUG_MODE=false

# API endpoint override (optional, for local development)
# VITE_API_ENDPOINT=http://localhost:5001

# ============================================================================
# LOCAL DEVELOPMENT NOTES
# ============================================================================
#
# For local development, create a .env.local file (not committed to git)
# and copy your actual Firebase credentials there.
#
# IMPORTANT: To enable local dev authentication on localhost and LAN IPs:
# 1. Go to Firebase Console → Authentication → Settings → Authorized domains
# 2. Add these domains:
#    - localhost
#    - 127.0.0.1
#    - Your local network IP (e.g., 192.168.x.x)
#
# This will prevent "auth/requests-from-referer-<local-ip>-are-blocked" errors.
#
# ============================================================================
