rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB for images
    }

    function isValidVideoSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB for videos
    }
    
    // ✅ PRIMARY PATH - Current uploads (photos and videos)
    match /users/{userId}/{albumId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
                       ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Unassigned album (temporary uploads - photos and videos)
    match /users/{userId}/unassigned/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
                       ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    
    // ✅ Thumbnails
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Vault (encrypted photos)
    match /vault/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Enhanced photos
    match /enhanced/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Legacy paths (backwards compatibility - photos and videos)
    match /photos/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
                       ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    match /thumbnails/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
