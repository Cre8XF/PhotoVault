rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }
    
    // ✅ PRIMARY PATH - Current uploads
    match /users/{userId}/{albumId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Thumbnails
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Vault (encrypted photos)
    match /vault/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Enhanced photos
    match /enhanced/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ Legacy paths (backwards compatibility)
    match /photos/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    match /thumbnails/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}