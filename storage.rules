rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper-funksjoner ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }
    function isValidVideoSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // --- Hovedbaner ---

    // 📂 Brukeropplastinger (bilder og videoer)
    match /users/{userId}/{albumId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) &&
        ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 📂 Midlertidige (unassigned)
    match /users/{userId}/unassigned/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) &&
        ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 📂 Thumbnails
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 📂 Vault (krypterte filer)
    match /vault/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 📂 Forbedrede bilder (enhanced)
    match /enhanced/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 📂 Legacy paths (kompatibilitet)
    match /photos/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) &&
        ((isImage() && isValidSize()) || (isVideo() && isValidVideoSize()));
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    match /thumbnails/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isImage() && isValidSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // 🚫 Alle andre stier nektes
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
