rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // -----------------------------
    // Helper Functions
    // -----------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email == "rogsor80@gmail.com";
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidImageSize() {
      return request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    function isValidVideoSize() {
      return request.resource.size < 200 * 1024 * 1024; // 200 MB
    }

    // -----------------------------
    // USERS
    // -----------------------------
    match /users/{userId}/{albumId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      ((isImage() && isValidImageSize()) ||
                       (isVideo() && isValidVideoSize()));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // UNASSIGNED (temporary uploads)
    // -----------------------------
    match /users/{userId}/unassigned/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      ((isImage() && isValidImageSize()) ||
                       (isVideo() && isValidVideoSize()));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // THUMBNAILS
    // -----------------------------
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      isImage() && isValidImageSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // VAULT (encrypted photos)
    // -----------------------------
    match /vault/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      request.resource.size < 50 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // ENHANCED (AI-improved images)
    // -----------------------------
    match /enhanced/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      isImage() && isValidImageSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // LEGACY (backward compatibility)
    // -----------------------------
    match /photos/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      ((isImage() && isValidImageSize()) ||
                       (isVideo() && isValidVideoSize()));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /thumbnails/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) &&
                      isImage() && isValidImageSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // FALLBACK
    // -----------------------------
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
